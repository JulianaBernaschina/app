  pod:    {ttl:'Podcast',      sub:'63 episodios · nuevos cada semana', items:[{c:'rd',ttl:'El oficio de escribir — Ep.5',info:'32 min · en vivo'},{c:'gn',ttl:'Kohan lee a Kohan — Ep.5',info:'18 min'},{c:'pu',ttl:'Lucrecia Martel conversa',info:'45 min'}]},

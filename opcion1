<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[índice] App</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-font-smoothing:antialiased}

/* ── Helvetica stack (system) + Playfair como Baskerville-surrogate ── */
:root{
  --cr:#8B1A4A;   /* crimson principal */
  --cr2:#6B1238;  /* crimson profundo */
  --cr3:rgba(139,26,74,0.18);
  --fo:#2C4A2E;   /* forest */
  --fo2:#3D6B40;
  --cm:#F5F2EB;   /* cream */
  --cm2:#EDE9E0;
  --td:#1A1208;
  --tm:#4A3728;
  --tmu:#8A7A6A;
  --bd:#D4CEC4;
  --hv:'Arial','Helvetica Neue',Helvetica,sans-serif; /* Helvetica system */
  --bk:'Playfair Display',Georgia,serif;               /* Baskerville-style */
}

body{font-family:var(--hv);background:#111;min-height:100vh;display:flex;justify-content:center;align-items:flex-start;padding:24px 0 48px}

.phone{
  width:360px;height:720px;border-radius:48px;background:#0a0a0a;
  box-shadow:
    0 0 0 1px rgba(255,255,255,0.06),
    0 0 0 2px rgba(0,0,0,0.8),
    0 32px 80px rgba(0,0,0,0.7),
    inset 0 0 0 1px rgba(255,255,255,0.05);
  position:relative;overflow:hidden;flex-shrink:0;
}
.notch{position:absolute;top:10px;left:50%;transform:translateX(-50%);width:88px;height:22px;background:#0a0a0a;border-radius:0 0 14px 14px;z-index:999}
.screen{position:absolute;inset:0;border-radius:48px;overflow:hidden}

/* ── PAGES ── */
.page{position:absolute;inset:0;border-radius:48px;overflow:hidden;display:none;flex-direction:column}
.page.active{display:flex}
.slide-up{animation:slideUp 0.55s cubic-bezier(0.22,1,0.36,1) both}
@keyframes slideUp{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}

/* ══════════════════════════════════════════════
   SPLASH
══════════════════════════════════════════════ */
#pg-splash{
  background:var(--cr);
  align-items:center;justify-content:center;
  display:flex;
}

/* Glow pulsante */
.sp-glow{
  position:absolute;width:340px;height:340px;border-radius:50%;
  background:radial-gradient(circle,rgba(181,53,106,0.45) 0%,transparent 68%);
  top:50%;left:50%;transform:translate(-50%,-50%);
  animation:gp 4s ease-in-out infinite;pointer-events:none;
}
@keyframes gp{0%,100%{opacity:0.5;transform:translate(-50%,-50%) scale(1)}50%{opacity:0.9;transform:translate(-50%,-50%) scale(1.18)}}

/* Tipografía de fondo — mezcla Helvetica uppercase + Baskerville */
.sp-bg-layer{
  position:absolute;inset:0;overflow:hidden;pointer-events:none;
}
.sp-bg-word{
  position:absolute;
  font-weight:900;
  color:rgba(255,255,255,0.045);
  line-height:1;
  white-space:nowrap;
}
.sp-bg-word.hv{font-family:var(--hv);text-transform:uppercase;letter-spacing:-0.04em}
.sp-bg-word.bk{font-family:var(--bk);font-style:italic;letter-spacing:-0.02em}
.sp-bg-word.w1{font-size:140px;top:2%;left:-8%;animation:bdrift1 11s ease-in-out infinite alternate}
.sp-bg-word.w2{font-size:90px;bottom:8%;right:-5%;animation:bdrift2 9s ease-in-out infinite alternate}
.sp-bg-word.w3{font-size:60px;top:42%;left:5%;opacity:0.03}
@keyframes bdrift1{from{transform:translateX(0)}to{transform:translateX(4%)}}
@keyframes bdrift2{from{transform:translateX(0)}to{transform:translateX(-4%)}}

/* Logo typewriter */
.sp-logo{position:relative;z-index:2;text-align:center}
.sp-row{
  font-size:58px;line-height:1;
  display:inline-flex;align-items:baseline;
  letter-spacing:-0.01em;color:#fff;
}
.sp-br{font-family:var(--hv);font-weight:300;opacity:0;transition:opacity 0.2s;font-size:52px}
.sp-br.v{opacity:1}
.sp-typed{display:inline-flex;align-items:baseline}
.sp-cur{display:inline-block;width:2.5px;height:0.72em;background:rgba(255,255,255,0.85);margin-left:1px;vertical-align:middle;animation:bl 0.5s step-end infinite}
.sp-cur.off{display:none}
@keyframes bl{0%,100%{opacity:1}50%{opacity:0}}
/* caracteres sans (Helvetica) */
.ch-s{font-family:var(--hv);font-weight:400;color:#fff;display:inline-block}
/* caracteres serif-italic (Baskerville/Playfair) */
.ch-i{font-family:var(--bk);font-style:italic;font-weight:400;color:rgba(255,255,255,0.94);display:inline-block}

.sp-tag{
  margin-top:18px;
  font-family:var(--bk);font-style:italic;
  font-size:13px;color:rgba(255,255,255,0);
  letter-spacing:0.03em;
  transition:color 1s;
}
.sp-tag.v{color:rgba(255,255,255,0.55)}

.sp-bar{position:absolute;bottom:0;left:0;right:0;height:2px;background:rgba(255,255,255,0.07)}
.sp-barf{height:100%;width:0;background:rgba(255,255,255,0.35);transition:none}

/* ══════════════════════════════════════════════
   LOGIN
══════════════════════════════════════════════ */
#pg-login{background:var(--cm)}

/* Fondo tipográfico — Helvetica ultra bold + Baskerville italic superpuestos */
.lg-bg-layer{
  position:absolute;inset:0;overflow:hidden;pointer-events:none;
}
.lg-bg-hv{
  /* "lo que los inspira" en Helvetica ultra, rotado */
  position:absolute;top:-12px;left:-14%;
  font-family:var(--hv);font-size:118px;font-weight:900;
  line-height:0.82;color:rgba(0,0,0,0.04);
  white-space:nowrap;transform:rotate(-6deg);
  text-transform:uppercase;letter-spacing:-0.04em;
}
.lg-bg-bk{
  /* overlay Baskerville italic encima, ligeramente desplazado */
  position:absolute;top:0px;left:-8%;
  font-family:var(--bk);font-size:118px;font-weight:400;font-style:italic;
  line-height:0.82;color:rgba(0,0,0,0.025);
  white-space:nowrap;transform:rotate(-6deg);
  letter-spacing:-0.02em;
}

.lg-inner{position:relative;z-index:1;padding:52px 24px 28px;flex:1;display:flex;flex-direction:column;overflow-y:auto}
.lg-inner::-webkit-scrollbar{display:none}

/* ── Logo en el login — versión correcta: [ín] con sans-bold + dice en baskerville ── */
.lg-logo{margin-bottom:32px}
.lg-logo-wrap{
  display:inline-flex;align-items:baseline;gap:0;
  font-size:30px;line-height:1;
}
.lg-br{font-family:var(--hv);font-weight:300;color:var(--fo);font-size:30px}
.lg-in{font-family:var(--hv);font-weight:900;color:var(--fo);font-size:30px;letter-spacing:-0.01em}
/* acento sobre la i */
.lg-in-accent{font-family:var(--hv);font-weight:900;color:var(--fo)}
.lg-dice{font-family:var(--bk);font-style:italic;font-weight:400;color:var(--fo);font-size:30px}
.lg-logo-sub{font-family:var(--bk);font-style:italic;font-size:12px;color:var(--tmu);margin-top:4px}

.lg-ttl{font-family:var(--hv);font-size:9px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--cr);margin-bottom:22px}
.fl{margin-bottom:22px}
.fl-lbl{font-family:var(--hv);font-size:9px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--tm);margin-bottom:8px;display:block}
.fl-inp{
  width:100%;border:none;border-bottom:1.5px solid var(--bd);background:transparent;
  padding:10px 0;font-family:var(--hv);font-size:14px;color:var(--td);
  outline:none;transition:border-color 0.2s;
}
.fl-inp:focus{border-bottom-color:var(--cr)}
.fl-inp::placeholder{color:var(--tmu);font-size:13px}
.fgt{
  text-align:right;margin-top:6px;
  font-size:11px;color:var(--cr);cursor:pointer;
  font-style:italic;font-family:var(--bk);
}
.btn-lg{
  width:100%;padding:15px;background:var(--cr);color:#fff;border:none;
  border-radius:50px;font-family:var(--hv);font-size:14px;font-weight:500;
  cursor:pointer;margin-top:8px;letter-spacing:0.03em;
  transition:transform 0.12s;
  box-shadow:0 6px 22px rgba(139,26,74,0.3);
}
.btn-lg:active{transform:scale(0.97)}
.dvd{display:flex;align-items:center;gap:10px;margin:20px 0;color:var(--tmu);font-size:10px;font-family:var(--hv)}
.dvd::before,.dvd::after{content:'';flex:1;height:1px;background:var(--bd)}
.soc{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn-soc{
  padding:12px;border:1.5px solid var(--bd);background:transparent;border-radius:50px;
  font-family:var(--hv);font-size:12px;font-weight:500;color:var(--tm);cursor:pointer;
  transition:border-color 0.2s;
}
.btn-soc:hover{border-color:var(--cr);color:var(--cr)}
.lg-foot{margin-top:auto;padding-top:20px;text-align:center}
.lg-foot p{font-size:12px;color:var(--tmu);font-family:var(--hv)}
.lg-foot a{color:var(--cr);font-weight:600;cursor:pointer;text-decoration:none}
.lg-terms{font-size:9px;color:var(--tmu);text-align:center;margin-top:12px;line-height:1.5;font-family:var(--hv)}
.lg-terms a{text-decoration:underline;cursor:pointer}

/* stagger login */
.lg-inner>*{opacity:0;transform:translateY(14px)}
.lg-inner.go>*{animation:stg 0.45s cubic-bezier(0.22,1,0.36,1) forwards}
.lg-inner.go>*:nth-child(1){animation-delay:.05s}.lg-inner.go>*:nth-child(2){animation-delay:.12s}
.lg-inner.go>*:nth-child(3){animation-delay:.19s}.lg-inner.go>*:nth-child(4){animation-delay:.26s}
.lg-inner.go>*:nth-child(5){animation-delay:.33s}.lg-inner.go>*:nth-child(6){animation-delay:.40s}
.lg-inner.go>*:nth-child(7){animation-delay:.47s}.lg-inner.go>*:nth-child(8){animation-delay:.54s}
@keyframes stg{to{opacity:1;transform:translateY(0)}}

/* ══════════════════════════════════════════════
   HOME
══════════════════════════════════════════════ */
#pg-home{background:var(--cm)}
.hm-scroll{flex:1;overflow-y:auto;padding-bottom:68px;position:relative}
.hm-scroll::-webkit-scrollbar{display:none}

/* top bar */
.topbar{
  position:sticky;top:0;z-index:50;
  background:rgba(245,242,235,0.88);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(212,206,196,0.3);
  padding:38px 16px 10px;
  display:flex;align-items:center;justify-content:space-between;
}
/* Logo en topbar: misma lógica [ín]dice */
.tl{display:inline-flex;align-items:baseline;font-size:19px;line-height:1}
.tl .tlb{font-family:var(--hv);font-weight:300;color:var(--fo)}
.tl .tli{font-family:var(--hv);font-weight:900;color:var(--fo)}
.tl .tld{font-family:var(--bk);font-style:italic;font-weight:400;color:var(--fo)}
.tmeta{font-size:9px;color:var(--tmu);position:absolute;left:50%;transform:translateX(-50%);letter-spacing:0.04em;font-family:var(--hv)}
.av{width:30px;height:30px;border-radius:50%;background:var(--fo);color:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;font-family:var(--hv)}

/* ── HERO ── */
.hero{
  margin:12px 12px 0;border-radius:18px;background:var(--fo);
  padding:22px 18px;position:relative;overflow:hidden;cursor:pointer;
  transition:transform 0.2s;
}
.hero:active{transform:scale(0.98)}
/* Juego tipográfico en el hero: número gigante Helvetica + texto baskerville */
.hero-bnum{
  position:absolute;right:-12px;top:-22px;
  font-family:var(--hv);font-size:160px;font-weight:900;
  color:rgba(255,255,255,0.05);line-height:1;pointer-events:none;
  letter-spacing:-0.05em;
}
/* Letras de fondo tipo magazine */
.hero-bg-letters{
  position:absolute;bottom:-10px;left:-4px;
  font-family:var(--bk);font-size:80px;font-weight:900;font-style:italic;
  color:rgba(255,255,255,0.04);line-height:1;pointer-events:none;
  letter-spacing:-0.03em;
  white-space:nowrap;
}
.hero-tag{font-family:var(--hv);font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.38);margin-bottom:10px;font-weight:400}
.hero-ttl{font-family:var(--bk);font-size:22px;font-weight:700;color:#fff;line-height:1.28;margin-bottom:10px}
.hero-mt{font-family:var(--hv);font-size:10px;color:rgba(255,255,255,0.38);letter-spacing:0.04em}

/* section header */
.sh{padding:20px 16px 8px;display:flex;align-items:baseline;justify-content:space-between}
.sh-t{font-family:var(--bk);font-size:17px;font-weight:700;color:var(--td)}
.sh-l{font-family:var(--hv);font-size:10px;color:var(--cr);cursor:pointer}

/* ── horizontal cards "Para escuchar" ── */
.hsc{padding:0 14px;display:flex;gap:10px;overflow-x:auto;padding-bottom:4px}
.hsc::-webkit-scrollbar{display:none}
.mc{
  flex:0 0 114px;border-radius:14px;overflow:hidden;position:relative;
  cursor:pointer;height:136px;transition:transform 0.2s;
}
.mc:nth-child(1){background:var(--cr2)}
.mc:nth-child(2){background:#2C4A2E}
.mc:nth-child(3){background:#3D2A5A}
.mc:active{transform:scale(0.93)}
/* letra tipográfica de fondo en cada card — Helvetica bold */
.mc-bg{
  position:absolute;inset:0;
  font-family:var(--hv);font-size:72px;font-weight:900;
  color:rgba(255,255,255,0.07);
  display:flex;align-items:flex-end;padding:4px;line-height:1;
  pointer-events:none;text-transform:uppercase;
}
.mc-in{position:relative;z-index:1;padding:10px;height:100%;display:flex;flex-direction:column;justify-content:flex-end}
.mc-tag{
  font-family:var(--hv);font-size:7px;letter-spacing:0.08em;
  text-transform:uppercase;color:rgba(255,255,255,0.42);
  margin-bottom:3px;background:rgba(0,0,0,0.2);
  display:inline-block;padding:2px 6px;border-radius:3px;width:fit-content;
}
.mc-live{background:var(--cr)!important;color:#fff!important;opacity:1!important}
.mc-tt{font-family:var(--bk);font-size:13px;font-weight:700;color:#fff;line-height:1.3}
.mc-sb{font-family:var(--hv);font-size:9px;color:rgba(255,255,255,0.42);margin-top:2px}

/* ── Player expandido ── */
.player-expanded{
  margin:8px 12px 0;border-radius:16px;overflow:hidden;
  background:#1a0a12;
  max-height:0;transition:max-height 0.5s cubic-bezier(0.4,0,0.2,1),opacity 0.4s;
  opacity:0;pointer-events:none;
  position:relative;
}
/* Fondo tipográfico del player — overlay Helvetica bold */
.pe-typo-bg{
  position:absolute;inset:0;overflow:hidden;pointer-events:none;
}
.pe-typo-bg span{
  position:absolute;
  font-weight:900;color:rgba(255,255,255,0.04);
  line-height:0.85;white-space:nowrap;
}
.pe-typo-bg .t1{font-family:var(--hv);font-size:90px;top:-8px;left:-6px;letter-spacing:-0.04em;text-transform:uppercase}
.pe-typo-bg .t2{font-family:var(--bk);font-size:70px;font-style:italic;bottom:-6px;right:-4px}
.player-expanded.open{max-height:250px;opacity:1;pointer-events:auto}
.pe-inner{padding:16px 14px 14px;position:relative;z-index:1}
.pe-live{display:flex;align-items:center;gap:6px;margin-bottom:10px}
.pe-live-dot{width:6px;height:6px;border-radius:50%;background:#E05577;animation:ld 1.2s ease-in-out infinite}
@keyframes ld{0%,100%{opacity:1}50%{opacity:0.3}}
.pe-live-txt{font-family:var(--hv);font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.45)}
.pe-tag{font-family:var(--hv);font-size:8px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:4px}
.pe-ttl{font-family:var(--bk);font-size:19px;font-weight:700;color:#fff;line-height:1.25;margin-bottom:2px}
.pe-sub{font-family:var(--hv);font-size:10px;color:rgba(255,255,255,0.38);margin-bottom:14px}
.pe-prog{height:2px;background:rgba(255,255,255,0.12);border-radius:2px;margin-bottom:6px;overflow:hidden}
.pe-pf{height:100%;width:45%;background:var(--cr);border-radius:2px}
.pe-times{display:flex;justify-content:space-between;font-family:var(--hv);font-size:9px;color:rgba(255,255,255,0.3);margin-bottom:14px}
.pe-ctrl{display:flex;align-items:center;justify-content:center;gap:18px}
.pe-play{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;cursor:pointer;border:1.5px solid rgba(255,255,255,0.18);font-size:13px;color:#fff;transition:background 0.2s}
.pe-play:active{background:rgba(255,255,255,0.2)}
.pe-skip{font-size:14px;color:rgba(255,255,255,0.38);cursor:pointer}
.pe-actions{display:flex;gap:8px;margin-top:12px;justify-content:center}
.pe-btn{font-family:var(--hv);font-size:9px;padding:5px 12px;border-radius:20px;border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.48);cursor:pointer;background:transparent;letter-spacing:0.04em}
.pe-btn.act{background:var(--cr);border-color:var(--cr);color:#fff}

/* ── Artistas / acordeones ── */
.art-sec{padding:0 14px}
.ai{border-bottom:1px solid var(--bd);overflow:hidden}
.ai-hd{display:flex;align-items:center;padding:12px 0;cursor:pointer;gap:10px}
/* número en Helvetica bold grande — dato tipográfico */
.ai-n{font-family:var(--hv);font-size:20px;font-weight:900;color:var(--bd);width:24px;flex-shrink:0;line-height:1}
.ai-nm{flex:1}
.ai-nm strong{display:block;font-family:var(--hv);font-size:13px;font-weight:500;color:var(--td)}
.ai-nm span{font-family:var(--hv);font-size:10px;color:var(--tmu)}
.ai-cv{font-size:11px;color:var(--tmu);transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1)}
.ai.open .ai-cv{transform:rotate(180deg)}
.ai-body{max-height:0;opacity:0;overflow:hidden;transition:max-height 0.45s cubic-bezier(0.4,0,0.2,1),opacity 0.3s}
.ai.open .ai-body{max-height:440px;opacity:1}

/* Perfil de artista */
.artist-profile{background:var(--cm2);border-radius:14px;overflow:hidden;margin:0 0 14px}
.ap-header{padding:18px 14px 14px;position:relative;overflow:hidden}
/* Juego tipográfico en header del artista: nombre en Helvetica ultra transparente de fondo, nombre real en Baskerville encima */
.ap-bg-txt{
  position:absolute;right:-10px;bottom:-20px;
  font-family:var(--hv);font-size:72px;font-weight:900;
  color:rgba(255,255,255,0.06);line-height:1;pointer-events:none;
  text-transform:uppercase;letter-spacing:-0.04em;
}
.ap-bg-bk{
  position:absolute;left:-6px;top:-10px;
  font-family:var(--bk);font-size:54px;font-weight:900;font-style:italic;
  color:rgba(255,255,255,0.04);line-height:1;pointer-events:none;
  letter-spacing:-0.02em;
}
.ap-badge{font-family:var(--hv);font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:6px}
.ap-name{font-family:var(--bk);font-size:24px;font-weight:900;color:#fff;line-height:1.1;margin-bottom:2px}
.ap-origin{font-family:var(--hv);font-size:9px;color:rgba(255,255,255,0.38)}
.ap-stats{display:flex;gap:16px;margin-top:10px}
.ap-stat-n{font-family:var(--hv);font-size:20px;font-weight:900;color:#fff;line-height:1}
.ap-stat-l{font-family:var(--hv);font-size:8px;color:rgba(255,255,255,0.38);margin-top:1px;line-height:1.3}
.ap-tabs{display:flex;gap:0;border-bottom:1px solid var(--bd);background:#fff;overflow-x:auto}
.ap-tabs::-webkit-scrollbar{display:none}
.ap-tab{
  flex:0 0 auto;text-align:center;padding:9px 10px;
  font-family:var(--hv);font-size:8px;letter-spacing:0.06em;text-transform:uppercase;
  color:var(--tmu);cursor:pointer;border-bottom:2px solid transparent;
  transition:all 0.2s;white-space:nowrap;
}
.ap-tab.act{color:var(--cr);border-bottom-color:var(--cr)}
.ap-bio{padding:12px 12px 8px;font-family:var(--hv);font-size:11px;color:var(--tm);line-height:1.65}
.ap-content{padding:0 10px 10px}
.ap-item{display:flex;gap:10px;padding:9px 2px;border-bottom:1px solid var(--bd);align-items:flex-start;cursor:pointer}
.ap-item:last-child{border-bottom:none}
.ap-thumb{width:34px;height:44px;border-radius:6px;flex-shrink:0}
.ap-thumb.rd{background:var(--cr2)}
.ap-thumb.dk{background:#2A1A10}

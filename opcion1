<script>
const dl = ms => new Promise(r => setTimeout(r, ms));

/* ── PAGE NAV ── */
function showPage(p) {
  ['splash','login','home'].forEach(x => {
    document.getElementById('pg-' + x).classList.remove('active','slide-up');
  });
  const pg = document.getElementById('pg-' + p);
  pg.classList.add('active');
  if (p !== 'splash') { void pg.offsetWidth; pg.classList.add('slide-up'); }
  if (p === 'login')  { setTimeout(() => { const i = document.getElementById('lgInner'); i.classList.remove('go'); void i.offsetWidth; i.classList.add('go'); }, 350); }
  if (p === 'home')   { setTimeout(initReveal, 200); }
  if (p === 'splash') { restartSplash(); }
}

document.getElementById('loginBtn').addEventListener('click', () => showPage('home'));

/* ── SCROLL REVEAL ── */
function initReveal() {
  const sc = document.getElementById('hmScroll');
  sc.querySelectorAll('.rv').forEach(el => el.classList.remove('vis'));
  const check = () => sc.querySelectorAll('.rv').forEach(el => {
    const r = el.getBoundingClientRect(), sr = sc.getBoundingClientRect();
    if (r.top < sr.bottom - 10) el.classList.add('vis');
  });
  sc.removeEventListener('scroll', check);
  sc.addEventListener('scroll', check, {passive:true});
  check();
}

/* Hero parallax */
document.getElementById('hmScroll').addEventListener('scroll', function(){
  const s = this.scrollTop;
  const h = document.getElementById('heroCard');
  if (h) h.style.transform = `translateY(${s * 0.18}px) scale(${Math.max(0.97, 1 - s * 0.0002)})`;
}, {passive:true});

/* ── SPLASH typewriter ── */
let splashRunning = false;
function restartSplash() {
  if (splashRunning) return;
  document.getElementById('typed').innerHTML = '';
  document.getElementById('cur').className = 'sp-cur';
  document.getElementById('brL').className = 'sp-br';
  document.getElementById('brR').className = 'sp-br';
  document.getElementById('spTag').className = 'sp-tag';
  const bar = document.getElementById('spBar');
  bar.style.transition = 'none'; bar.style.width = '0';
  setTimeout(runSplash, 80);
}

async function runSplash() {
  splashRunning = true;
  const typed = document.getElementById('typed');
  const cur   = document.getElementById('cur');
  const brL   = document.getElementById('brL');
  const brR   = document.getElementById('brR');
  const tag   = document.getElementById('spTag');
  const bar   = document.getElementById('spBar');

  await dl(450);
  brL.classList.add('v'); brR.classList.add('v');
  await dl(200);

  // Escribir "índice" en Helvetica (sans)
  const full = ['í','n','d','i','c','e'];
  let spans = [];
  for (let c of full) {
    if (!document.getElementById('pg-splash').classList.contains('active')) { splashRunning=false; return; }
    const s = document.createElement('span');
    s.className = 'ch-s'; s.textContent = c;
    typed.appendChild(s); spans.push(s);
    await dl(72 + Math.random() * 38);
  }
  await dl(620);

  // Borrar "dice" (4 chars)
  for (let i = 0; i < 4; i++) {
    const last = spans.pop();
    if (last) typed.removeChild(last);
    await dl(52 + Math.random() * 28);
  }
  await dl(230);

  // Reescribir "dice" en Baskerville italic
  for (let c of ['d','i','c','e']) {
    const s = document.createElement('span');
    s.className = 'ch-i'; s.textContent = c;
    typed.appendChild(s); spans.push(s);
    await dl(80 + Math.random() * 32);
  }

  await dl(320);
  cur.classList.add('off');
  tag.classList.add('v');
  bar.style.transition = 'width 2.4s ease';
  bar.style.width = '100%';
  await dl(2700);
  splashRunning = false;
  showPage('login');
}

